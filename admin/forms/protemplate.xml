<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="basic">

		<field
			name="id"
			type="hidden"
		/>

		<field
			name="title"
			type="text"
			label="FLEXI_TITLE"
			required="true"
			class="form-control"
			size="60"
		/>

		<field
			name="type_id"
			type="sql"
			label="FLEXI_PROTEMPLATE_TYPE"
			description="FLEXI_PROTEMPLATE_TYPE_DESC"
			query="SELECT id, name AS title FROM #__flexicontent_types WHERE published=1 ORDER BY name"
			key_field="id"
			value_field="title"
			default="0"
			first_option="FLEXI_PROTEMPLATE_ALL_TYPES"
			first_hasnt_key="true"
			class="form-select"
			showon="view_scope:item"
		/>

		<field
			name="catid"
			type="sql"
			label="FLEXI_CATEGORY"
			description="FLEXI_PROTEMPLATE_CATID_DESC"
			query="SELECT id, title FROM #__categories WHERE extension='com_content' AND published=1 ORDER BY title"
			key_field="id"
			value_field="title"
			default="0"
			first_option="FLEXI_PROTEMPLATE_ALL_CATS"
			first_hasnt_key="true"
			class="form-select"
		/>

		<!--
			view_scope: locked by the chooser screen on create. Hidden in the
			builder so editors never have to think about it (it would also
			contradict the chooser's promise — "this is your item layout").
		-->
		<field name="view_scope" type="hidden" default="item"/>

		<!--
			assignment_type + assignment_value: auto-derived in
			FlexicontentModelProtemplate::save() based on catid + type_id.
			Hidden in the form so editors only set the filter dimensions
			that matter (Category, Type) and the routing column is
			computed for them.
		-->
		<field name="assignment_type"  type="hidden" default="global"/>
		<field name="assignment_value" type="hidden" default=""/>

		<field
			name="theme_id"
			type="hidden"
			default="0"
		/>

		<field
			name="layout_data"
			type="hidden"
			default=""
		/>

		<field
			name="state"
			type="list"
			label="JSTATUS"
			default="1"
			class="form-select"
		>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>

		<field
			name="ordering"
			type="number"
			label="JFIELD_ORDERING_LABEL"
			default="0"
			class="form-control"
		/>

		<field
			name="note"
			type="text"
			label="JGLOBAL_FIELD_NOTE_LABEL"
			default=""
			class="form-control"
			size="255"
		/>

	</fieldset>
</form>
